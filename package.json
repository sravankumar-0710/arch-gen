{
  "name": "archgen-ai",
  "version": "1.0.0-mvp",
  "description": "AI-powered architectural floor plan generator",
  "main": "electron/main.js",
  "scripts": {
    "dev:frontend": "cd src && vite",
    "dev:electron": "electron .",
    "dev:backend": "cd backend && python -m uvicorn app:app --reload --host 127.0.0.1 --port 8000",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:electron\" \"npm run dev:backend\"",
    "build": "cd src && vite build",
    "build:electron": "electron-builder",
    "lint": "eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "autoprefixer": "^10.4.27",
    "axios": "^1.13.6",
    "electron": "^28.0.0",
    "konva": "^10.2.3",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.2.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.archgen.ai",
    "productName": "ArchGen AI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "src/dist/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
